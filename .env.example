# Ideno v0.1 configuration.
#
# Copy to `.env` and edit. Nothing here is required to start the server, but
# Ideno cannot reason about an idea until one AI provider is configured.
# `.env` is git-ignored; never commit a real key.

# ---------------------------------------------------------------- server ---
IDENO_PORT=8787
IDENO_HOST=0.0.0.0
IDENO_LOG_LEVEL=info          # debug | info | warn | error

# --------------------------------------------------------------- storage ---
IDENO_STORE=file              # file | memory  (memory loses everything on exit)
IDENO_DATA_DIR=data/cases

# ----------------------------------------------------------- AI provider ---
# Pick ONE of the two blocks below.

# (a) Any OpenAI-compatible /chat/completions endpoint. This covers OpenAI,
#     OpenRouter, Groq, Together, vLLM, LM Studio, llama.cpp and Ollama's /v1,
#     which is why it is the default adapter.
#
#     Local example (no key needed, nothing leaves the machine):
#       IDENO_OPENAI_BASE_URL=http://localhost:11434/v1
#       IDENO_OPENAI_MODEL=qwen2.5:14b-instruct
#
# IDENO_OPENAI_BASE_URL=https://api.openai.com/v1
# IDENO_OPENAI_MODEL=gpt-4o-mini
# IDENO_OPENAI_API_KEY=
#
# response_format mode. `json_object` is the portable default; Ideno probes it
# and permanently falls back to `none` if the endpoint rejects it.
# IDENO_OPENAI_RESPONSE_FORMAT=json_object   # json_object | json_schema | none
#
# Newer OpenAI models require `max_completion_tokens`; most other servers only
# understand `max_tokens`. Ideno sends neither unless a stage asks for a limit.
# IDENO_OPENAI_TOKEN_LIMIT_FIELD=max_tokens  # max_tokens | max_completion_tokens

# (b) Puter AI gateway. Server-side use needs an auth token; obtain one with
#     the Puter CLI (`puter login`) or `getAuthToken()` from @heyputer/puter.js.
#     Leave unset to keep the adapter dormant — it is only initialised on first
#     use, because the Puter SDK opens background connections at init time.
# IDENO_PUTER_AUTH_TOKEN=
# IDENO_PUTER_MODEL=gpt-5.4-nano

# Force a specific adapter. Defaults to the first configured one, in order.
# IDENO_AI_PROVIDER=openai-compatible

# Per-request budget and retry policy for the AI runtime.
IDENO_REQUEST_TIMEOUT_MS=90000
IDENO_AI_MAX_ATTEMPTS=2

# -------------------------------------------------------------- research ---
IDENO_RESEARCH_ENABLED=1
# Allows the fetcher to reach private/loopback addresses. Leave OFF unless you
# are deliberately researching against a local server: enabling it removes the
# SSRF protection that stops a URL from probing your own network.
IDENO_RESEARCH_ALLOW_PRIVATE_ADDRESSES=0

# ------------------------------------------------------------------- UI ----
IDENO_UI_PORT=5173            # Vite dev server (development only)
IDENO_UI_DIR=dist/ui          # built client, served by the API in production
IDENO_SERVE_UI=1
